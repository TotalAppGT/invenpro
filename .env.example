# InvenPro SaaS

# Environment
NODE_ENV=production

# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://..."

# Session Encryption Key (32+ characters - use `openssl rand -hex 32`)
SESSION_ENCRYPTION_KEY=

# Resend Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@invenpro.gt

# Recurrente (Pasarela de Pago Guatemalteca)
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
RECURRENTE_PUBLIC_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=InvenPro
